# ===== LATHISH VAULT environment =====
# ALL variables below are SERVER-SIDE ONLY (Vercel Project Settings > Environment Variables).
# The browser receives no configuration at all: auth is proxied through /api/auth/*,
# so even the Supabase anon key stays on the server. Never add a NEXT_PUBLIC_/VITE_ prefix.

# --- Supabase ---
SUPABASE_URL=https://khsvicksjpwzqfvbhzvx.supabase.co
# Publishable / anon key. Used server-side only for the password-grant and recovery calls.
SUPABASE_ANON_KEY=sb_publishable_8IXklhNR0jFsNpsi8dRXjg_EP1g5Brt
# SECRET. service_role / secret key. Bypasses RLS. Never expose it or commit it.
SUPABASE_SECRET_KEY=your_secret_key_here
# UUID of the single owner (printed by `npm run create-owner`). Only this user may use the vault.
OWNER_USER_ID=lathishcp .env.example .env.local
# Owner e-mail. Password reset mails are only ever requested for this address.
OWNER_EMAIL=lathishwaran522@gmail.com

# --- Backblaze B2 (S3-compatible API) ---
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET=your-private-bucket-name
B2_KEY_ID=replace-with-application-key-id
# SECRET.
B2_APPLICATION_KEY=replace-with-application-key

# --- Application ---
# Exact production origin, no trailing slash. Used for Origin (CSRF) checks, cookies and CORS.
APP_ORIGIN=https://vault.example.com
# SECRET. >= 32 random chars. Vercel Cron sends it as a Bearer token to /api/storage/cleanup.
CRON_SECRET=replace-with-long-random-string
# Optional: comma-separated extensions refused at upload (no dots). Default shown.
BLOCKED_EXTENSIONS=scr,pif,vbs,bat,cmd,com
